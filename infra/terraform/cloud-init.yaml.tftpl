#cloud-config
# Rendered by Terraform (templatefile). Contains a Tailscale auth key: the
# rendered text is secret. Shell `$` is written `$$` so Terraform leaves it.
hostname: ${hostname}
manage_etc_hosts: true
timezone: UTC
ssh_pwauth: false
disable_root: true

users:
  - name: deploy
    gecos: Deploy user
    shell: /bin/bash
    lock_passwd: true
    # No password exists, so sudo must be passwordless. Key-only login is the
    # gate. deploy is root-equivalent (sudo + docker); see security.md.
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: [sudo]
    ssh_authorized_keys:
      - ${ssh_public_key}

swap:
  filename: /swapfile
  size: 2G
  maxsize: 2G

package_update: true
package_upgrade: true
packages:
  - ca-certificates
  - curl
  - gnupg
  - rsync
  - fail2ban
  - unattended-upgrades
  - ufw

write_files:
  - path: /etc/ssh/sshd_config.d/10-hardening.conf
    permissions: "0644"
    content: |
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PubkeyAuthentication yes
      AllowUsers deploy
      MaxAuthTries 3

  # Single source of truth: the same script used for the live server.
  - path: /usr/local/sbin/harden-host.sh
    permissions: "0700"
    encoding: b64
    content: ${harden_script_b64}

  - path: /etc/fail2ban/jail.d/10-sshd.local
    permissions: "0644"
    content: |
      [DEFAULT]
      # Never ban loopback or the tailnet (CGNAT range Tailscale uses).
      ignoreip = 127.0.0.1/8 ::1 100.64.0.0/10
      bantime  = 1h
      findtime = 10m
      maxretry = 5

      [sshd]
      enabled = true
      backend = systemd

  - path: /etc/apt/apt.conf.d/20auto-upgrades
    permissions: "0644"
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";

  # 05:30 UTC sits mid-candle on the 4h timeframe (candles close 00/04/08...).
  # Containers use restart: unless-stopped and come back on their own.
  - path: /etc/apt/apt.conf.d/52unattended-upgrades-local
    permissions: "0644"
    content: |
      Unattended-Upgrade::Automatic-Reboot "true";
      Unattended-Upgrade::Automatic-Reboot-Time "05:30";
      Unattended-Upgrade::Remove-Unused-Dependencies "true";

  - path: /etc/docker/daemon.json
    permissions: "0644"
    content: |
      {
        "log-driver": "json-file",
        "log-opts": { "max-size": "10m", "max-file": "3" }
      }

runcmd:
  # --- Docker Engine + compose plugin from Docker's official apt repo ------
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  - chmod a+r /etc/apt/keyrings/docker.asc
  - |
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $${VERSION_CODENAME}) stable" > /etc/apt/sources.list.d/docker.list

  # --- Tailscale from its official apt repo ---------------------------------
  - curl -fsSL https://pkgs.tailscale.com/stable/ubuntu/noble.noarmor.gpg -o /usr/share/keyrings/tailscale-archive-keyring.gpg
  - curl -fsSL https://pkgs.tailscale.com/stable/ubuntu/noble.tailscale-keyring.list -o /etc/apt/sources.list.d/tailscale.list

  - apt-get update
  - DEBIAN_FRONTEND=noninteractive apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin tailscale
  - usermod -aG docker deploy
  - systemctl enable --now docker

  # --- App directory (rsync target for make deploy) -------------------------
  - install -d -o deploy -g deploy -m 0750 /opt/ai-trading-agent

  # --- Join the tailnet. --ssh is off: we use normal sshd over the tailnet. -
  - systemctl enable --now tailscaled
  - tailscale up --authkey='${tailscale_authkey}' --hostname='${hostname}' --ssh=false

  # --- Conductor dashboard: tailnet-only HTTPS (3A-5, ADR-0017) ------------
  # `serve` (tailnet only), never `funnel` (public). Proxies to the loopback port the
  # conductor container publishes. Needs "HTTPS certificates" enabled for the tailnet
  # (admin console -> DNS); if that is not done yet this times out and is NOT fatal:
  # run the same command by hand later (provision-vps.md step 24). cloud-init only
  # runs once, so an already-provisioned VPS needs that manual step too.
  - timeout 60 tailscale serve --bg --https=443 http://127.0.0.1:8000 || echo "tailscale serve not applied; see provision-vps.md step 24"

  # --- Host firewall + sshd bind (defence in depth) -----------------------
  # ufw default-deny + allow tailscale0 only. First boot has bootstrap_ssh=true,
  # so SSH from admin_cidr stays allowed and ssh.socket is left on all
  # addresses until you run harden-host.sh over Tailscale (provision-vps.md
  # 12a), which removes that rule and binds ssh.socket to the tailnet IP only.
  # With bootstrap_ssh=false it binds ssh.socket to the tailnet IP right away.
  - bash /usr/local/sbin/harden-host.sh --cloud-init%{ if bootstrap_ssh } --allow-public-ssh-from ${admin_cidr}%{ endif }

  # --- Apply SSH hardening and services ------------------------------------
  - sshd -t
  - systemctl restart ssh
  - systemctl enable --now fail2ban
  - systemctl restart fail2ban

  # --- Scrub the auth key from local copies of user-data -------------------
  # (The key is single-use and now consumed; this is belt and braces.)
  - rm -f /var/lib/cloud/instance/user-data.txt /var/lib/cloud/instance/user-data.txt.i /var/lib/cloud/instance/scripts/runcmd /var/lib/cloud/instance/cloud-config.txt
  - rm -f /var/lib/cloud/instances/*/user-data.txt /var/lib/cloud/instances/*/user-data.txt.i /var/lib/cloud/instances/*/scripts/runcmd /var/lib/cloud/instances/*/cloud-config.txt

final_message: "ai-trader-vps cloud-init finished after $UPTIME seconds"
