{
  "$comment": "Phase 2 dry-run config. dry_run is hard-coded true — see docs/04-architecture/execution-freqtrade.md. Never flip this to false by hand; a promotion to live is a Conductor-issued config change (Phase 3+), not a manual edit.",
  "max_open_trades": 3,
  "stake_currency": "USD",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "dry_run": true,
  "dry_run_wallet": 100,
  "cancel_open_orders_on_exit": false,
  "trading_mode": "spot",
  "timeframe": "4h",
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "order_types": {
    "$comment": "Limit entry/exit prefers maker fills per docs/04-architecture/execution-freqtrade.md ('Order preference'); stoploss stays market so it always fills.",
    "entry": "limit",
    "exit": "limit",
    "stoploss": "market",
    "stoploss_on_exchange": false
  },
  "order_time_in_force": {
    "entry": "GTC",
    "exit": "GTC"
  },
  "exchange": {
    "name": "kraken",
    "key": "",
    "secret": "",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [
      "BTC/USD",
      "ETH/USD",
      "SOL/USD"
    ],
    "pair_blacklist": [
      "ADA/.*",
      "DOT/.*",
      "KAVA/.*",
      "SC/.*",
      "ACA/.*",
      "XTZ/.*"
    ]
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "protections": [
    {
      "method": "CooldownPeriod",
      "stop_duration_candles": 2
    },
    {
      "method": "StoplossGuard",
      "lookback_period_candles": 6,
      "trade_limit": 3,
      "stop_duration_candles": 3,
      "only_per_pair": false,
      "only_per_side": false
    },
    {
      "method": "MaxDrawdown",
      "lookback_period_candles": 48,
      "trade_limit": 20,
      "stop_duration_candles": 3,
      "max_allowed_drawdown": 0.1
    }
  ],
  "telegram": {
    "enabled": false,
    "token": "",
    "chat_id": ""
  },
  "api_server": {
    "$comment": "Bound to 0.0.0.0 inside the container; infra/docker-compose.yml publishes it to the host as 127.0.0.1:8080 only. Credentials are blank here and injected at runtime via FREQTRADE__API_SERVER__* env vars (see .env.example) so no secret is committed.",
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": false,
    "jwt_secret_key": "",
    "CORS_origins": [],
    "username": "",
    "password": ""
  },
  "bot_name": "ai-trading-agent-dryrun",
  "initial_state": "running",
  "force_entry_enable": false,
  "internals": {
    "process_throttle_secs": 5
  }
}
