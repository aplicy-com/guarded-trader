# Copy to .env and fill in real values. NEVER commit .env.
# .env is git-ignored; this file only documents the shape of the config.
# See docs/04-architecture/security.md for key-scope requirements.

# --- Kraken (Phase 2+) ---------------------------------------------------
# Create with permissions: Query Funds, Query Open/Closed Orders,
# Query Ledger Entries, Create/Modify/Cancel Orders ONLY.
# Withdrawal permission must be OFF. IP-whitelist the host.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- Anthropic (Phase 3+, Conductor research loop) -----------------------
ANTHROPIC_API_KEY=

# --- Telegram (Phase 3+, alerts + kill switch / flatten commands) -------
TELEGRAM_BOT_TOKEN=
# Comma-separated allowlist of Telegram user/chat IDs permitted to issue
# control commands (kill switch, flatten, re-enable).
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Conductor ledger DB (Phase 3+) --------------------------------------
DATABASE_URL=

# --- Risk parameters (Phase 2+, mirrored into Freqtrade + Conductor config) --
PRINCIPAL_USD=100
DAILY_LOSS_LIMIT_PCT=3
MAX_DRAWDOWN_PCT=10
CONSECUTIVE_LOSS_LIMIT=3

# --- Runtime mode ---------------------------------------------------------
# dry_run (paper) | live — must default to dry_run everywhere.
TRADING_MODE=dry_run
