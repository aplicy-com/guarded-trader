# Copy to .env and fill in real values. NEVER commit .env.
# .env is git-ignored; this file only documents the shape of the config.
# See docs/04-architecture/security.md for key-scope requirements.

# --- Kraken (Phase 2+) ---------------------------------------------------
# Create with permissions: Query Funds, Query Open/Closed Orders,
# Query Ledger Entries, Create/Modify/Cancel Orders ONLY.
# Withdrawal permission must be OFF. IP-whitelist the host.
# Phase 4 live pilot (ADR-0019): leave BLANK until docs/06-runbooks/go-live-pilot.md says
# otherwise. Create a QUERY-ONLY key first and test it with scripts/kraken-access-check.sh
# --scope query-only; replace it with the query + create/cancel-orders key only when the pilot
# goes live. Only the freqtrade container receives it (infra/docker-compose.live.yml); the
# conductor container never does. Never a key with withdraw or funding permission.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- NDAX (spike/ndax only) -----------------------------------------------
# READ-ONLY key for scripts/ndax-access-check.sh --scope read-only. NDAX_UID is the numeric
# user id shown with the key. NDAX_ACCOUNT_ID (optional) is the numeric account id; if empty
# the check resolves it with a key-signed GetUserAccounts. Never add an NDAX login, password or
# 2FA secret here: no login is used, and the script refuses to run if any of them is set.
NDAX_API_KEY=
NDAX_API_SECRET=
NDAX_UID=
NDAX_ACCOUNT_ID=

# --- Freqtrade REST API (Phase 2+) ----------------------------------------
# Loopback-only (infra/docker-compose.yml binds 127.0.0.1:8080). Auth is
# still required so a local process on the host can't hit the API
# unauthenticated. Generate real values with e.g. `openssl rand -hex 32`
# for the JWT secret; never reuse these across environments.
FREQTRADE__API_SERVER__USERNAME=
FREQTRADE__API_SERVER__PASSWORD=
FREQTRADE__API_SERVER__JWT_SECRET_KEY=

# --- Anthropic (Phase 3+, Conductor research loop) -----------------------
ANTHROPIC_API_KEY=

# --- Telegram (Conductor: alerts + commands; 3A-4, ADR-0015) --------------
# Freqtrade's own Telegram bot is DISABLED (config.dry_run.json telegram.enabled=false);
# Conductor owns the bot. Use the SAME bot you already created with @BotFather:
#   TELEGRAM_BOT_TOKEN       = the token that used to be FREQTRADE__TELEGRAM__TOKEN
#   TELEGRAM_ALLOWED_CHAT_IDS = the chat id that used to be FREQTRADE__TELEGRAM__CHAT_ID
# (get a chat id by messaging the bot once, then opening
#  https://api.telegram.org/bot<token>/getUpdates and reading "chat":{"id":...}).
# Both or neither: Conductor refuses to start with only one set. Comma-separated
# for several chats. Only these chats can issue commands; everyone else is ignored.
# The token is passed to the conductor container ONLY (blanked for freqtrade).
# Leave both blank to run without Telegram (alerts are then only logged).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
# true (default) = answer commands. false = alerts only, no polling: use it for a
# second/dev Conductor that shares the real bot, which must be polled by one process only.
TELEGRAM_COMMANDS_ENABLED=true

# --- Heartbeat (Conductor, 3A-5) --------------------------------------------
# healthchecks.io ping URL for this system's check (https://hc-ping.com/<uuid>). It embeds
# the check's UUID, so treat it as a secret. Conductor pings it every 5 minutes ONLY while it
# is healthy (database ok, scheduler running, last risk cycle succeeded within 3 minutes), and
# pings <url>/fail with a short reason when it is not. Silence is what makes healthchecks.io
# alert you, so set the check's period to 5 min and grace to 10 min (alerts after ~15 min of
# silence). Blank = no external heartbeat (logged only). Conductor container only.
HEALTHCHECK_PING_URL=

# --- Backups (Conductor, 3A-5, ADR-0016) -------------------------------------
# Nightly 03:15 UTC backup of the ledger and Freqtrade's dry-run DB to Backblaze B2 via its
# S3-compatible API. The application key must be WRITE-ONLY (upload only: no read, list or
# delete) and limited to this bucket. Do NOT put a read key here: restore drills take a read
# key from your shell at run time (docs/06-runbooks/restore-backup.md). All four values or
# none (Conductor refuses to start with a partial set). Conductor container only.
#   BACKUP_B2_ENDPOINT looks like https://s3.<region>.backblazeb2.com (https only).
BACKUP_B2_BUCKET=
BACKUP_B2_ENDPOINT=
BACKUP_B2_KEY_ID=
BACKUP_B2_APP_KEY=
# Optional: SigV4 region. Derived from a Backblaze endpoint when blank.
BACKUP_B2_REGION=

# --- Conductor ledger DB (Phase 3+) --------------------------------------
# SQLite only (ADR-0009). In compose this is fixed to sqlite:////data/conductor.db
# (a named volume); set it only when running Conductor outside Docker.
DATABASE_URL=

# --- Risk parameters (Phase 2+, mirrored into Freqtrade + Conductor config) --
# These are the DRY-RUN values. The live pilot pins its own in infra/docker-compose.live.yml
# (PRINCIPAL_USD=20, DAILY_PROFIT_CAP_USD=2, one position), so this file cannot change them.
PRINCIPAL_USD=100
DAILY_LOSS_LIMIT_PCT=3
MAX_DRAWDOWN_PCT=10
CONSECUTIVE_LOSS_LIMIT=3
# R7 correlation guard: all whitelisted pairs are ONE exposure group. Conductor
# halts entries if more than this many positions are open. Must equal
# max_open_trades in services/freqtrade/user_data/config.dry_run.json.
MAX_CONCURRENT_POSITIONS=2
# How often Conductor re-checks the risk limits and re-applies halts (seconds, min 15).
RISK_CHECK_INTERVAL_SECONDS=60

# --- Profit fence (R3, Conductor) -------------------------------------------
# Working profit above this cap is fenced daily (ledger-only). 10 USD is the
# working default; the final value is still to be ratified (Phase 3,
# docs/02-requirements.md). BLANK means nothing is fenced and a warning is logged.
DAILY_PROFIT_CAP_USD=10
# Alert when fenced-but-unmoved profit reaches this (draft $25, TBD Phase 3).
MANUAL_MOVE_THRESHOLD_USD=25

# --- Runtime mode ---------------------------------------------------------
# dry_run (paper) | live — must default to dry_run everywhere.
TRADING_MODE=dry_run
