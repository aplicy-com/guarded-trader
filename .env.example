# Copy to .env and fill in real values. NEVER commit .env.
# .env is git-ignored; this file only documents the shape of the config.
# See docs/04-architecture/security.md for key-scope requirements.

# --- Kraken (Phase 2+) ---------------------------------------------------
# Create with permissions: Query Funds, Query Open/Closed Orders,
# Query Ledger Entries, Create/Modify/Cancel Orders ONLY.
# Withdrawal permission must be OFF. IP-whitelist the host.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# --- Freqtrade REST API (Phase 2+) ----------------------------------------
# Loopback-only (infra/docker-compose.yml binds 127.0.0.1:8080). Auth is
# still required so a local process on the host can't hit the API
# unauthenticated. Generate real values with e.g. `openssl rand -hex 32`
# for the JWT secret; never reuse these across environments.
FREQTRADE__API_SERVER__USERNAME=
FREQTRADE__API_SERVER__PASSWORD=
FREQTRADE__API_SERVER__JWT_SECRET_KEY=

# --- Anthropic (Phase 3+, Conductor research loop) -----------------------
ANTHROPIC_API_KEY=

# --- Freqtrade Telegram bot, status-only (Phase 2D+) ----------------------
# A SEPARATE bot/token from TELEGRAM_BOT_TOKEN below -- two processes can't
# share one bot's getUpdates/webhook without colliding, and this bot and
# the future Conductor bot are different services with different command
# surfaces. Create via @BotFather in Telegram ("/newbot"); get your chat_id
# by messaging the new bot once, then GET
# https://api.telegram.org/bot<token>/getUpdates and reading "chat":{"id":...}
# (or ask @userinfobot). See infra/README.md "Telegram bot (status-only)".
FREQTRADE__TELEGRAM__TOKEN=
FREQTRADE__TELEGRAM__CHAT_ID=

# --- Telegram (Phase 3+, Conductor: alerts + kill switch / flatten commands) --
TELEGRAM_BOT_TOKEN=
# Comma-separated allowlist of Telegram user/chat IDs permitted to issue
# control commands (kill switch, flatten, re-enable).
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Conductor ledger DB (Phase 3+) --------------------------------------
# SQLite only (ADR-0009). In compose this is fixed to sqlite:////data/conductor.db
# (a named volume); set it only when running Conductor outside Docker.
DATABASE_URL=

# --- Risk parameters (Phase 2+, mirrored into Freqtrade + Conductor config) --
PRINCIPAL_USD=100
DAILY_LOSS_LIMIT_PCT=3
MAX_DRAWDOWN_PCT=10
CONSECUTIVE_LOSS_LIMIT=3

# --- Profit fence (R3, Conductor) -------------------------------------------
# Working profit above this cap is fenced daily (ledger-only). 10 USD is the
# working default; the final value is still to be ratified (Phase 3,
# docs/02-requirements.md). BLANK means nothing is fenced and a warning is logged.
DAILY_PROFIT_CAP_USD=10
# Alert when fenced-but-unmoved profit reaches this (draft $25, TBD Phase 3).
MANUAL_MOVE_THRESHOLD_USD=25

# --- Runtime mode ---------------------------------------------------------
# dry_run (paper) | live — must default to dry_run everywhere.
TRADING_MODE=dry_run
